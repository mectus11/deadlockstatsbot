# Required: your Discord bot token (Discord Developer Portal -> Bot -> Reset Token)
DISCORD_TOKEN=

# Optional: Statlocker API key (enables PP score, rank and lobby rank on the cards).
# Keys are issued by application at https://statlocker.gg/api . Leave empty until approved.
STATLOCKER_API_KEY=

# Optional: Deadlock API key (works without one; a key only raises rate limits).
DEADLOCK_API_KEY=

# Optional: seconds between checks for new matches (default 120, minimum 30)
POLL_SECONDS=120

# Optional: seconds between checks for new Deadlock patch notes on Steam (default 600, minimum 300)
PATCH_POLL_SECONDS=600

# Optional: where the SQLite database file lives (default ./bot.db)
DB_PATH=bot.db

# Optional: where downloaded hero/item pictures are cached (default ./cache)
CACHE_DIR=cache
